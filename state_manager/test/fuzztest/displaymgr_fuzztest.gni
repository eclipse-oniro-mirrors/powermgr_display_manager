import("../../../displaymgr.gni")

declare_args() {
  displaymgr_fuzz_defines = []
  displaymgr_fuzz_external_deps = []
  displaymgr_fuzz_sources = []
}

if (display_manager_feature_multi_screen_state) {
  displaymgr_fuzz_defines += [ "DISPLAY_MANAGER_ENABLE_MULTI_SCREEN_STATE" ]
  displaymgr_fuzz_external_deps += [
    "common_event_service:cesfwk_innerkits",
    "os_account:os_account_innerkits",
  ]
  displaymgr_fuzz_sources += [
    "${displaymgr_root_path}/service/native/src/multi_screen_display_state_callback_manager.cpp",
    "${displaymgr_root_path}/service/zidl/src/multi_screen_display_state_callback_proxy.cpp",
    "${displaymgr_root_path}/service/zidl/src/multi_screen_display_state_callback_stub.cpp",
  ]
}
